# ZinuRooms environment template
# Copy to .env for local development only. Never commit real values.
# Preview, staging and production must use environment-specific secrets and databases.

# ----------------------------------------------------------------------------
# Runtime identity
# ----------------------------------------------------------------------------
NODE_ENV="development"
APP_ENV="local"

# Canonical application URLs
WEB_APP_URL="http://localhost:3000"
PARTNER_APP_URL="http://localhost:3001"
ADMIN_APP_URL="http://localhost:3002"

# Auth.js canonical URL for the app being run locally.
# Individual hosted apps may require their own AUTH_URL/callback configuration.
AUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ----------------------------------------------------------------------------
# Pooled connection for application traffic.
DATABASE_URL="postgresql://user:password@pooler-host.neon.tech/dbname?sslmode=require"

# Direct, non-pooled connection for migrations, pg_dump and administration.
DATABASE_DIRECT_URL="postgresql://user:password@direct-host.neon.tech/dbname?sslmode=require"

# Optional provider metadata used by tooling/operations.
NEON_PROJECT_ID=""

# ----------------------------------------------------------------------------
# Authentication and OAuth — server-only unless explicitly marked public
# ----------------------------------------------------------------------------
# Required. Use at least 32 random bytes. Application code fails closed when it is
# absent or weak; there is no fallback secret.
AUTH_SECRET="replace-with-at-least-32-random-bytes-not-a-human-password"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required mobile JWT identity. Access-token TTL defaults to 24 hours and may be
# configured only between 15 minutes (900) and 7 days (604800).
MOBILE_JWT_ISSUER="zinurooms"
MOBILE_JWT_AUDIENCE="zinurooms-mobile"
MOBILE_JWT_TTL_SECONDS="86400"

# Optional comma-separated additional Google OAuth client IDs accepted for Flutter
# Android/iOS tokens. AUTH_GOOGLE_ID is also accepted. The Flutter build must receive
# the backend/server OAuth client ID with --dart-define=GOOGLE_SERVER_CLIENT_ID=...
MOBILE_GOOGLE_CLIENT_IDS=""

# ----------------------------------------------------------------------------
# Stripe payments
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Currency and financial policy are authoritative server-side configuration/data.
# Do not accept exchange rate, booking total, commission or wallet amount from clients.
DEFAULT_PAYMENT_CURRENCY="bdt"

# Server-authoritative booking-v1 pricing policy. Percentages accept at most two
# decimal places. First-booking discount is applied only to an authenticated
# mobile user's first non-cancelled platform booking.
BOOKING_TAX_RATE_PERCENT="15.00"
FIRST_BOOKING_DISCOUNT_PERCENT="20.00"
FIRST_BOOKING_DISCOUNT_CAP="1000.00"

# ----------------------------------------------------------------------------
# Firebase / FCM
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Preserve escaped newlines when configured in hosted environments.
FIREBASE_PRIVATE_KEY=""

# Public Flutter/Firebase platform configuration belongs in the platform-specific
# generated/config files and provider consoles; do not expose server credentials.

# ----------------------------------------------------------------------------
# Web Push (only if the current web-push path remains enabled)
# ----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ----------------------------------------------------------------------------
# Media/object storage
# ----------------------------------------------------------------------------
# Current Vercel Blob integration.
BLOB_READ_WRITE_TOKEN=""

# Reserved for the provider-neutral R2/S3 storage workstream.
OBJECT_STORAGE_PROVIDER="vercel-blob"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ----------------------------------------------------------------------------
# Realtime service — Cloudflare Worker/Durable Objects
# ----------------------------------------------------------------------------
REALTIME_URL="https://realtime.example.com"
REALTIME_AUTH_SECRET=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# ----------------------------------------------------------------------------
# Scheduled/internal endpoints
# ----------------------------------------------------------------------------
# Required for every mutation-capable cron/internal endpoint. Missing or invalid
# values must fail closed; there is no unauthenticated fallback mode.
CRON_SECRET=""

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Optional OpenTelemetry configuration when introduced/configured.
OTEL_SERVICE_NAME="zinurooms-local"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ----------------------------------------------------------------------------
# Legacy/optional payment-provider placeholders
# ----------------------------------------------------------------------------
# These fields are not proof of a production-ready integration. Keep blank unless
# the corresponding provider workstream has implemented and tested the gateway.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_NUMBER=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
